# =============================================================================
# HireSphere Root Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting docker compose or deploying.
# Never commit real credentials or production secrets to source control.

# Database: SQL Server connection string
# For Docker on Windows connecting to local SQL Server Express:
# DATABASE_CONNECTION_STRING=Server=host.docker.internal,1433;Database=HireSphereDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;
# For Azure SQL Database:
# DATABASE_CONNECTION_STRING=Server=tcp:yourserver.database.windows.net,1433;Database=HireSphereDb;User ID=cloudadmin;Password=YourPassword123!;Encrypt=True;TrustServerCertificate=False;
DATABASE_CONNECTION_STRING=Server=host.docker.internal,1433;Database=HireSphereDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;

# Security: JWT Signing Secret Key (Must be at least 32 characters, cryptographically random)
JWT_SECRET_KEY=HireSphere_Production_Super_Secret_Jwt_Signing_Key_2026_At_Least_32_Bytes!

# Optional: Production SMTP Email Settings
# If left empty, HireSphere runs in safe dev-logging mode (records attempts in dbo.EmailDeliveryAttempts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=no-reply@hiresphere.com
