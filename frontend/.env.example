# HireSphere Frontend Environment Configuration
# =============================================================================
# Development: Point directly to the local ASP.NET Core API server
VITE_API_BASE_URL=http://localhost:5000/api

# Production Option A (Unified Host / Reverse Proxy / Docker Compose):
# When frontend and backend are reverse-proxied behind Nginx/IIS on the same domain,
# set to '/api' or leave empty (defaults to '/api' in production builds).
# VITE_API_BASE_URL=/api

# Production Option B (Dedicated Backend Host / Subdomain):
# When the API runs on a separate origin, specify the absolute HTTPS API URL:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
