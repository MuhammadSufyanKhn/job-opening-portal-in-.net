# HireSphere Frontend Production Environment Template
# =============================================================================
# Set to your production API URL before running `npm run build`.
# Note: Vite environment variables are embedded at BUILD time.
#
# If backend is on a dedicated domain:
VITE_API_BASE_URL=https://api.yourdomain.com/api
#
# If backend is reverse-proxied under /api on the same domain:
# VITE_API_BASE_URL=/api
